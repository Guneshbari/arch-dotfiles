{
  "items": [
    {
      "key": "!",
      "type": "tmux",
      "command": "break-pane",
      "description": "Break pane to window"
    },
    {
      "key": "\"",
      "type": "tmux",
      "command": "split-window",
      "description": "Split window vertically"
    },
    {
      "key": "#",
      "type": "tmux",
      "command": "list-buffers",
      "description": "List buffers"
    },
    {
      "key": "$",
      "type": "tmux",
      "command": "command-prompt -I '#S' 'rename-session \"%%\"'",
      "description": "Rename session"
    },
    {
      "key": "%",
      "type": "tmux",
      "command": "split-window -h",
      "description": "Split window horizontally"
    },
    {
      "key": "&",
      "type": "tmux",
      "command": "confirm-before -p 'kill-window #W? (y/n)' kill-window",
      "description": "Kill window"
    },
    {
      "key": "'",
      "type": "tmux",
      "command": "command-prompt -T window-target -p index 'select-window -t \":%%\"'",
      "description": "Select window by index"
    },
    {
      "key": "(",
      "type": "tmux",
      "command": "switch-client -p",
      "description": "Previous session"
    },
    {
      "key": ")",
      "type": "tmux",
      "command": "switch-client -n",
      "description": "Next session"
    },
    {
      "key": "*",
      "type": "tmux",
      "command": "new-pane",
      "description": "New pane"
    },
    {
      "key": ",",
      "type": "tmux",
      "command": "command-prompt -I '#W' 'rename-window \"%%\"'",
      "description": "Rename window"
    },
    {
      "key": "-",
      "type": "tmux",
      "command": "delete-buffer",
      "description": "Delete buffer"
    },
    {
      "key": ".",
      "type": "tmux",
      "command": "command-prompt -T target 'move-window -t \"%%\"'",
      "description": "Move window"
    },
    {
      "key": "/",
      "type": "tmux",
      "command": "command-prompt -k -p key 'list-keys -1N \"%%\"'",
      "description": "Describe key"
    },
