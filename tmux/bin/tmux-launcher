#!/bin/sh

# Existing tmux server → attach.
if tmux has-session 2>/dev/null; then
    exec tmux attach-session
fi

# Resurrect save exists → let Continuum restore it.
if ls "$HOME/.local/share/tmux/resurrect/"tmux_resurrect_*.txt >/dev/null 2>&1; then
    exec tmux new-session
fi

# No existing server and no saved state → ask for a name.
printf "New tmux session name: "
read -r session_name

[ -z "$session_name" ] && exit 1

exec tmux new-session -s "$session_name"
